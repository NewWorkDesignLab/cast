---
// Development only: stands in for the headset app.
export const prerender = false;
if (import.meta.env.PROD) return new Response(null, { status: 404 });
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>cast test publisher</title>
  </head>
  <body>
    <h1>Test publisher</h1>
    <p>
      Stands in for the headset app: publishes a test pattern as a screen share and one microphone track with two beeps,
      low for the microphone and high for the app sound. Keep this window visible, browsers slow down background tabs.
    </p>
    <form id="form">
      <label>Device ID <input id="device-id" value="test01" required /></label>
      <label>Device secret <input id="device-secret" type="password" required /></label>
      <button id="start" type="submit">Start streaming</button>
      <button id="stop" type="button" disabled>Stop streaming</button>
    </form>
    <p id="status" role="status"></p>
    <canvas id="canvas" width="1280" height="720"></canvas>

    <script>
      import { Room, Track, VideoPreset } from 'livekit-client';

      const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const form = byId<HTMLFormElement>('form');
      const startButton = byId<HTMLButtonElement>('start');
      const stopButton = byId<HTMLButtonElement>('stop');
      const statusText = byId('status');
      const canvas = byId<HTMLCanvasElement>('canvas');

      // Same format as the headset app. Without an explicit encoding LiveKit picks a preset capped at 20-30 fps.
      // Simulcast: the server gives each viewer the layer that fits its connection and tile size.
      const FPS = 60;
      const VIDEO = {
        simulcast: true,
        videoEncoding: { maxBitrate: 3_000_000, maxFramerate: FPS },
        videoSimulcastLayers: [new VideoPreset(320, 180, 300_000, 30), new VideoPreset(640, 360, 1_200_000, 60)],
        degradationPreference: 'balanced' as const,
      };

      let room: Room | null = null;
      let stopMedia = () => {};

      function startMedia() {
        const ctx = canvas.getContext('2d')!;
        let frame = 0;
        const draw = setInterval(() => {
          frame++;
          const now = new Date();
          ctx.fillStyle = `hsl(${frame % 360} 50% 25%)`;
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.fillStyle = '#fff';
          ctx.textAlign = 'center';
          ctx.font = 'bold 112px monospace';
          ctx.fillText(`${now.toLocaleTimeString('en-GB')}.${String(now.getMilliseconds()).padStart(3, '0')}`, 640, 340);
          ctx.font = '64px monospace';
          ctx.fillText(`#${frame}`, 640, 460);
        }, 1000 / FPS);

        // Both beeps in one track, as the headset app mixes the app sound into the microphone
        const audio = new AudioContext();
        const destination = audio.createMediaStreamDestination();
        const tone = (frequency: number) => {
          const oscillator = audio.createOscillator();
          const gain = audio.createGain();
          oscillator.frequency.value = frequency;
          gain.gain.value = 0;
          oscillator.connect(gain).connect(destination);
          oscillator.start();
          return gain.gain;
        };
        const mic = tone(440);
        const app = tone(880);
        let tick = 0;
        const beep = setInterval(() => {
          tick++;
          mic.value = tick % 4 === 0 ? 0.2 : 0;
          app.value = tick % 4 === 2 ? 0.2 : 0;
        }, 250);

        return {
          video: canvas.captureStream(FPS).getVideoTracks()[0],
          audio: destination.stream.getAudioTracks()[0],
          stop: () => {
            clearInterval(draw);
            clearInterval(beep);
            audio.close();
          },
        };
      }

      async function stopStreaming() {
        await room?.disconnect();
        room = null;
        stopMedia();
        stopMedia = () => {};
        startButton.disabled = false;
        stopButton.disabled = true;
      }

      form.onsubmit = async (event) => {
        event.preventDefault();
        startButton.disabled = true;
        statusText.textContent = 'Starting…';
        const deviceId = byId<HTMLInputElement>('device-id').value;
        try {
          const res = await fetch('/api/token/device', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ deviceId, deviceSecret: byId<HTMLInputElement>('device-secret').value }),
          });
          if (!res.ok) throw new Error(`Token request failed (HTTP ${res.status})`);
          const { url, token } = await res.json();
          room = new Room({ dynacast: true }); // pause layers no viewer needs
          await room.connect(url, token);
          const media = startMedia();
          stopMedia = media.stop;
          const local = room.localParticipant;
          await local.publishTrack(media.video, { name: 'screen', source: Track.Source.ScreenShare, ...VIDEO });
          await local.publishTrack(media.audio, { name: 'mic', source: Track.Source.Microphone });
          stopButton.disabled = false;
          statusText.textContent = `Streaming as device-${deviceId}`;
        } catch (err) {
          await stopStreaming();
          statusText.textContent = err instanceof Error ? err.message : String(err);
        }
      };

      stopButton.onclick = async () => {
        await stopStreaming();
        statusText.textContent = 'Stopped';
      };
    </script>

    <style>
      body {
        font-family: system-ui, sans-serif;
        margin: 16px;
      }
      form {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: center;
      }
      canvas {
        width: 640px;
        max-width: 100%;
        margin-top: 1rem;
      }
    </style>
  </body>
</html>
